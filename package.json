{
  "name": "@usage-fyi/cli",
  "version": "0.0.1",
  "description": "Publish Claude Code usage snapshots to usage.fyi.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usage-fyi": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usage-fyi/cli.git"
  },
  "homepage": "https://usage.fyi",
  "bugs": {
    "url": "https://github.com/usage-fyi/cli/issues"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ test/",
    "verify": "bun run typecheck && bun run lint && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^0.16.0",
    "typescript": "^5.8.3"
  }
}
