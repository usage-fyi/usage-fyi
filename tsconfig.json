{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@usage-fyi/core": ["./src/core/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
