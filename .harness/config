# Harness configuration — shell-sourceable key=value pairs
# Copy this file to .harness/config and adjust for your project.
#
#   cp .harness/config.example .harness/config

# Commands to run for verification after Claude finishes.
# This runs as a single shell command via eval, so use && to chain.
# Leave empty or unset to skip verification.
VERIFY_CMD="just verify"

# The branch to create iteration branches from.
# Each iteration creates harness/NN-task-slug from this branch.
BASE_BRANCH="main"

# Maximum number of times to retry verification after failure.
# On each retry, Claude is re-invoked with the failure output to fix the issues.
# Set to 0 to disable retries.
MAX_VERIFY_RETRIES=2

# Automatically push the branch and create a GitHub PR after each iteration.
# Requires the gh CLI to be installed. Set to "false" to disable.
AUTO_PR="true"

# Automatically merge the PR after creation (requires AUTO_PR="true").
# After merge, switches back to BASE_BRANCH and pulls. Set to "true" to enable.
AUTO_MERGE="false"

# Strategy when tracked files are dirty after a PR merge.
# Options: auto-commit (legacy behavior), claude-triage, pause.
# See docs/06_technical_architecture.md and the P017 design for details.
# Existing repos default to auto-commit when this key is absent.
POST_MERGE_DIRTY_STRATEGY=claude-triage

# Group all tasks in the same plan onto a shared feature branch.
# When enabled, PRs from each task target the feature branch instead of BASE_BRANCH.
# The feature branch is only merged to main when explicitly requested.
# FEATURE_BRANCH_MODE="false"

# Per-step model overrides. When set, these override MODEL for the given step.
# When unset, falls back to MODEL if set, or defaults to claude-sonnet-4-6.
# This keeps costs down by using Sonnet for routine coding work while
# preserving Opus for complex tasks (debate/ideation always use MODEL).
# IMPLEMENTATION_MODEL=claude-sonnet-4-6
# STATE_MODEL=claude-sonnet-4-6
# NEXT_PROMPT_MODEL=claude-sonnet-4-6

# Model used by 'harness plan generate'. This single call decides both task
# topology AND writes every body in one shot — a weak model produces
# under-decomposition AND poor bodies. Defaults to claude-opus-4-7 so plans
# are decomposed thoroughly even when MODEL is downgraded to Sonnet for cost.
# Override only if you have a stronger or specifically-tuned model preference.
# STEP_PLAN_GENERATE_MODEL=claude-opus-4-7
# STEP_PLAN_GENERATE_FIX_MODEL=claude-opus-4-7

# Optional post-PR reviewer step: run a second AI model against the PR diff
# before auto-merge. When enabled, the step is inserted between push_pr and
# auto_merge. Provider/model fall back to AI_PROVIDER defaults when unset.
# POST_PR_REVIEW=false
# POST_PR_REVIEW_PROVIDER=claude
# POST_PR_REVIEW_MODEL=claude-opus-4-7
# POST_PR_REVIEW_MODE=warn

# Stall detection: kill Claude when no stdout activity for this many minutes.
# Prevents truly stuck processes without killing long-running but active ones.
# COMPLEX tasks can sit silent for several minutes while Claude thinks, so
# don't set this too aggressively. Default: 20 minutes. Set to 0 to disable.
# STALL_TIMEOUT_MINUTES=20

# Reuse Claude sessions across iterations to avoid re-exploring the codebase.
# Default: "false" — fresh session per iteration. Session reuse saves tokens
# when tasks are related (overlapping files), but inflates token usage for
# unrelated tasks because prior tool outputs remain in context. Enable only
# when you know consecutive iterations work in the same area of the codebase.
# SESSION_REUSE="false"

# Maximum cumulative input tokens before starting a fresh session.
# Prevents context exhaustion from too many resumed iterations.
# Default: 150000. Only relevant when SESSION_REUSE="true".
# MAX_SESSION_TOKENS=150000

# Keep looping even when the AI provider reports "no remaining work".
# By default the loop exits early when all tasks are done.
# Set to "true" to continue generating prompts regardless.
# LOOP_ON_NO_WORK="false"

# Prevent the computer from sleeping during loop runs (macOS only).
# Uses caffeinate to inhibit idle sleep. Set to "false" to disable.
# PREVENT_SLEEP="true"

# Auto-generate the iteration prompt when it's missing.
# When enabled, harness will invoke Claude to identify the next task
# and assemble a prompt, instead of erroring out.
# AUTO_GENERATE_PROMPT="true"

# Maximum number of times to retry state capture (summary generation) on failure.
# Set to 0 to disable retries and use placeholder text immediately.
# MAX_STATE_RETRIES=2

# Minutes to wait when Claude credit exhaustion is detected before retrying.
# Set to 0 to skip the wait and fail immediately.
# CREDIT_WAIT_MINUTES=60

# Maximum number of credit-exhaustion waits per pipeline step before giving up.
# Higher values help long --loop sessions survive multiple credit refresh cycles.
# MAX_CREDIT_WAITS=3

# Maximum cumulative minutes to spend waiting for credit refreshes per step.
# Prevents unbounded waits in automated pipelines.
# Default: 120 (2 hours). Set to 0 to disable the cap.
# MAX_TOTAL_WAIT_MINUTES=120

# Maximum retries for non-verification pipeline steps (push, PR, merge).
# When a step fails, Claude is invoked with the error to attempt a fix.
# Set to 0 to disable (fail-forward immediately as before).
# PIPELINE_FIX_RETRIES=1

# Maximum retries for lint-fix loop on harness-generated files.
# After generation, harness can run a linter and ask the model to fix issues.
# Set to 0 to disable the fix loop (detect-and-log only).
# MAX_LINT_FIX_RETRIES=1

# Work mode controls what kind of work the harness looks for.
# "continuous" (default): Uses a 6-tier priority cascade that includes
#   vision gaps, code quality, and documentation work beyond explicit tasks.
# "tasks-only": Only looks at QA feedback, task list, and future ideas —
#   stops when all explicit items are done.
# WORK_MODE="continuous"

# Pre-iteration ancestry check: before starting iteration N, verify that
# iteration N-1's commit is an ancestor of HEAD. If not:
#   "true"  — auto-merge the previous iteration's branch into the current branch
#   "false" — exit with an error asking the user to merge manually
# AUTO_MERGE_PREVIOUS="false"

# Skip the ancestry check entirely and log a warning instead of blocking.
# Useful for unattended --loop runs where PRs may not be merged yet.
# When true, a missing ancestor logs a warning and continues.
# Takes precedence over AUTO_MERGE_PREVIOUS when both are set.
# AUTO_SKIP_ANCESTRY="false"

# Maximum cumulative cost (USD) allowed across all iterations in a loop run.
# When the running total exceeds this cap the loop stops gracefully.
# Optional — omit or leave unset for no cost limit.
# MAX_COST_USD=50.00

# Spin detection: abort when N consecutive iterations produce zero new commits.
# Catches stuck-loop failure modes in overnight --loop runs before they waste budget.
# Default: 2 (a single zero-commit iteration never trips). Set to 0 to disable.
# Override per-run with HARNESS_ALLOW_SPIN=1 environment variable.
# SPIN_THRESHOLD=2

# Design gate: complexity threshold that routes tasks to a design-only iteration.
# Items at or above this complexity get a design doc before implementation begins.
# Options: L (default, includes L and XL), XL (only XL), none (disable gate).
# DESIGN_GATE_THRESHOLD=L

# Skip the design gate for all items (auto-approve mode).
# When true, L/XL items skip the design-only iteration and go straight to code.
# Useful for solo flows where the developer acts as their own design reviewer.
# DESIGN_GATE_AUTO_APPROVE=false

# Hard per-iteration budget circuit breaker. If an iteration's running cost
# (summed across all Claude invocations within that iteration) reaches this
# value, harness aborts immediately with exit code 6 before spending more.
# Also readable as env var HARNESS_MAX_COST_PER_ITER (env var takes precedence).
# Default: 5.00 (USD). Set to 0 to disable, or raise for complex workloads.
# MAX_COST_PER_ITER=5.00

# Maximum character length for autogenerated design, plan, and task doc bodies.
# Generation that produces a body exceeding this limit is rejected with an error,
# prompting the operator to re-run or tighten the generation prompt.
# Default: 10000 chars. Raise for complex designs; lower to enforce brevity.
# MAX_DOC_CHARS=10000

# PR title vs. diff verification (Haiku). After PR creation and before
# AUTO_MERGE, harness runs a Haiku invocation that checks whether the PR
# title accurately describes the diff. On mismatch, emits a warning line.
# Never blocks the merge. Only runs when AUTO_MERGE="true".
# Default: "false" (trial period — flip to "true" after confirming low
# false-positive rate over a full loop).
# PR_TITLE_CHECK="false"

# Complexity threshold for auto-approving newly-created design docs.
# Designs at or below this complexity are automatically approved at creation
# time (inside the design-only iteration's worktree); designs above the
# threshold remain status: waiting and require `harness design approve`.
# Options: none (default — all designs require explicit approval), S, M, L.
# AUTO_APPROVE_DESIGN_COMPLEXITY=none

# Optional post-PR reviewer step: run a second AI model against the PR diff
# before auto-merge. When enabled, the step is inserted between push_pr and
# auto_merge. Provider/model fall back to AI_PROVIDER defaults when unset.
# POST_PR_REVIEW=false
# POST_PR_REVIEW_PROVIDER=claude
# POST_PR_REVIEW_MODEL=claude-opus-4-7
# POST_PR_REVIEW_MODE=warn

# Maximum retries for lint-fix loop on harness-generated files.
# After generation, harness can run a linter and ask the model to fix issues.
# Set to 0 to disable the fix loop (detect-and-log only).
# MAX_LINT_FIX_RETRIES=1
