{
  "name": "@usage-fyi/wire",
  "version": "0.1.1",
  "description": "Shared wire contract for usage.fyi — canonicalization, content hash, and the byte-identical wire-shape types that producers (the usage-fyi CLI) and consumers (the usage.fyi server) must both understand. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usage-fyi/usage-fyi.git",
    "directory": "packages/wire"
  },
  "homepage": "https://usage.fyi",
  "bugs": {
    "url": "https://github.com/usage-fyi/usage-fyi/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ test/",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "oxlint": "^1.67.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
